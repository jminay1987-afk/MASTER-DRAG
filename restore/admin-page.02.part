_id))];
  const {data:piques}=piqueIds.length?await s.from("piques").select("pique_id,categoria_fecha_id,correlativo,ronda,tipo,estado,iniciado_at,confirmado_at,anulado_deportivamente").in("pique_id",piqueIds).order("iniciado_at",{ascending:false}):{data:[]};
  const vehIds=[...new Set([...(parts||[]).map((x:any)=>x.vehiculo_id),...(lanes||[]).map((x:any)=>x.vehiculo_id)].filter(Boolean))];
  const {data:vehs}=vehIds.length?await s.from("vehiculos").select("vehiculo_id,marca,modelo,anio,patente,motor,traccion").in("vehiculo_id",vehIds):{data:[]};
  const dm=new Map((dates||[]).map((x:any)=>[x.fecha_id,x])), cm=new Map((cats||[]).map((x:any)=>[x.categoria_id,x])), cfm=new Map((cfs||[]).map((x:any)=>[x.categoria_fecha_id,x])), pm=new Map((parts||[]).map((x:any)=>[x.participacion_id,x])), qm=new Map((piques||[]).map((x:any)=>[x.pique_id,x])), vm=new Map((vehs||[]).map((x:any)=>[x.vehiculo_id,x]));
  const attendanceBySeason=new Map<string,number>();for(const a of atts||[]){const d:any=dm.get(a.fecha_id);if(d?.temporada_id)attendanceBySeason.set(d.temporada_id,(attendanceBySeason.get(d.temporada_id)||0)+1)}
  const careerResults=(results||[]).map((r:any)=>{const cf:any=cfm.get(r.categoria_fecha_id),d:any=cf?dm.get(cf.fecha_id):null,c:any=cf?cm.get(cf.categoria_id):null;return {...r,date:d,cat:c}}).sort((a:any,b:any)=>String(b.date?.fecha_calendario_principal||"").localeCompare(String(a.date?.fecha_calendario_principal||"")));
  const laneHistory=(lanes||[]).map((l:any)=>{const q:any=qm.get(l.pique_id),cf:any=q?cfm.get(q.categoria_fecha_id):null,d:any=cf?dm.get(cf.fecha_id):null,c:any=cf?cm.get(cf.categoria_id):null,part:any=pm.get(l.participacion_id),veh:any=vm.get(l.vehiculo_id||part?.vehiculo_id);return {...l,q,date:d,cat:c,veh}}).sort((a:any,b:any)=>String(b.q?.iniciado_at||"").localeCompare(String(a.q?.iniciado_at||"")));
  const validTimes=laneHistory.filter((x:any)=>x.condicion==="VALIDO"&&x.tiempo_final_s!=null&&!x.q?.anulado_deportivamente).map((x:any)=>Number(x.tiempo_final_s));
  const bestValid=validTimes.length?Math.min(...validTimes):null;
  const totalPoints=careerResults.filter((x:any)=>x.estado==="OFICIAL").reduce((n:number,x:any)=>n+Number(x.puntos_totales||0),0);
  return <><section className="opCard pilotIdentity"><div><small>PILOTO</small><h2>{pilot.nombres} {pilot.apellidos}</h2><p>{pilot.rut} · {pilot.estado}</p></div><div className="pilotKpis"><div><small>TEMPORADAS</small><b>{seasonRows?.length||0}</b></div><div><small>ASISTENCIAS</small><b>{atts?.length||0}</b></div><div><small>PIQUES</small><b>{laneHistory.length}</b></div><div><small>MEJOR VÁLIDO</small><b>{bestValid!=null?bestValid.toFixed(3):"—"}</b></div><div><small>PUNTOS</small><b>{totalPoints}</b></div></div></section>
    <section className="opCard"><div className="opCardHead"><div><h2>TEMPORADAS Y ASISTENCIA</h2><p>La asistencia se cuenta una sola vez por fecha, independiente de las categorías.</p></div></div><div className="pilotSeasonRows">{(seasonRows||[]).length?(seasonRows||[]).map((pt:any)=>{const sea:any=sm.get(pt.temporada_id),n=attendanceBySeason.get(pt.temporada_id)||0,min=Number(sea?.min_asistencias_premio??7);return <article key={pt.piloto_temporada_id}><b>{sea?.anio||"—"} · #{pt.numero_competencia}</b><span>{sea?.nombre||"Temporada"}</span><strong className={n>=min?"okText":""}>{n} / {min} asistencias</strong><small>{n>=min?"HABILITADO PARA PREMIO ANUAL":"AÚN NO HABILITADO"}</small></article>}):<div className="notice compact"><b>Sin temporadas registradas.</b></div>}</div></section>
    <section className="opCard"><div className="opCardHead"><div><h2>RESULTADOS, PUNTOS Y BONOS</h2><p>Historial por fecha y categoría.</p></div></div><div className="pilotResultRows">{careerResults.length?careerResults.map((r:any,i:number)=><article key={`${r.participacion_id}-${i}`}><div><b>{r.date?.nombre||"Fecha"} · {r.cat?.codigo||r.cat?.nombre||"Categoría"}</b><span>{r.date?.fecha_calendario_principal||"—"} · {r.date?.autodromo||"—"}</span></div><strong>{r.posicion?`${r.posicion}°`:"—"}</strong><span>Base {r.puntos_posicion||0} · Exacto +{r.bono_exacto||0} · Mejor +{r.bono_mejor_tiempo||0}</span><b>{r.puntos_totales||0} pts</b></article>):<div className="notice compact"><b>Sin resultados registrados.</b></div>}</div></section>
    <section className="opCard"><div className="opCardHead"><div><h2>HISTORIAL DE PIQUES</h2><p>Tiempos, condición, ronda y vehículo utilizado en cada pique.</p></div><span className="opBadge ok">{laneHistory.length} REGISTROS</span></div><div className="pilotPiqueRows">{laneHistory.length?laneHistory.map((l:any)=><article key={l.pique_piloto_id}><div><b>{l.date?.nombre||"Fecha"} · {l.cat?.codigo||l.cat?.nombre||"Categoría"}</b><span>Pique #{l.q?.correlativo||"—"} · {String(l.q?.ronda||"—").replaceAll("_"," ")} · {String(l.condicion||"SIN DATO").replaceAll("_"," ")}</span></div><strong>{l.tiempo_final_s!=null?Number(l.tiempo_final_s).toFixed(3):"—"}</strong><small>R {l.reaccion_s!=null?Number(l.reaccion_s).toFixed(3):"—"} · 60ft {l.tiempo_60ft_s!=null?Number(l.tiempo_60ft_s).toFixed(3):"—"} · 100m {l.tiempo_100m_s!=null?Number(l.tiempo_100m_s).toFixed(3):"—"} · {l.velocidad_final_kmh!=null?`${Number(l.velocidad_final_kmh).toFixed(1)} km/h`:"—"}</small><span>{l.veh?[l.veh.marca,l.veh.modelo,l.veh.patente].filter(Boolean).join(" · "):"Vehículo sin registrar"}</span></article>):<div className="notice compact"><b>Sin piques registrados.</b></div>}</div></section>
  </>
}

async function GrillaPanel({s,active,selectedCat,quickQ}:{s:any,active:any,selectedCat?:string,quickQ?:string}){
  if(!active)return <div className="operatorPanel"><div className="notice"><b>No existe una fecha Master Drag disponible.</b></div></div>;
  if(String(active.estado)==="SUSPENDIDA")return <div className="operatorPanel"><div className="notice"><b>FECHA SUSPENDIDA</b><span>Grilla está congelada hasta que Juez/Admin inicie la jornada de continuación.</span></div></div>;
  const {data:cats}=await s.from("categoria_fecha").select("categoria_fecha_id,categoria_id,estado,orden_operativo,participantes_oficiales").eq("fecha_id",active.fecha_id).order("orden_operativo");
  const catIds=(cats||[]).map((x:any)=>x.categoria_id);const {data:defs}=catIds.length?await s.from("categorias").select("categoria_id,codigo,nombre,tiempo_limite_s").in("categoria_id",catIds):{data:[]};
  const defMap=new Map((defs||[]).map((d:any)=>[d.categoria_id,d]));const full=(cats||[]).map((c:any)=>({...c,def:defMap.get(c.categoria_id)}));
  const current=full.find((c:any)=>c.categoria_fecha_id===selectedCat)||full[0];if(!current)return <div className="operatorPanel"><div className="notice"><b>La fecha no tiene categorías configuradas.</b></div></div>;
  const {data:pcs}=await s.from("participaciones_categoria").select("participacion_id,piloto_temporada_id,vehiculo_id,estado,primer_pique_oficial_at,retiro_definitivo").eq("categoria_fecha_id",current.categoria_fecha_id).order("created_at");
  const ptIds=(pcs||[]).map((p:any)=>p.piloto_temporada_id);const {data:pts}=ptIds.length?await s.from("piloto_temporada").select("piloto_temporada_id,piloto_id,numero_competencia").in("piloto_temporada_id",ptIds):{data:[]};
  const pilotoIds=(pts||[]).map((p:any)=>p.piloto_id);const {data:pilotos}=pilotoIds.length?await s.from("pilotos").select("piloto_id,rut,nombres,apellidos").in("piloto_id",pilotoIds):{data:[]};
  const vehIds=(pcs||[]).map((p:any)=>p.vehiculo_id).filter(Boolean);const {data:vehs}=vehIds.length?await s.from("vehiculos").select("vehiculo_id,marca,modelo,patente").in("vehiculo_id",vehIds):{data:[]};
  const ptMap=new Map((pts||[]).map((x:any)=>[x.piloto_temporada_id,x]));const piMap=new Map((pilotos||[]).map((x:any)=>[x.piloto_id,x]));const vMap=new Map((vehs||[]).map((x:any)=>[x.vehiculo_id,x]));
  const rows=(pcs||[]).map((pc:any)=>{const pt:any=ptMap.get(pc.piloto_temporada_id);const pi:any=pt?piMap.get(pt.piloto_id):null;const v:any=pc.vehiculo_id?vMap.get(pc.vehiculo_id):null;return {...pc,pt,pi,v}});
  const temporadaId=active.temporada_id;
  return <div className="operatorPanel">
    <section className="opSummary"><div><small>EVENTO ACTIVO</small><b>{active.nombre}</b></div><div><small>CATEGORÍA ACTIVA</small><b>{current.def?.codigo||current.def?.nombre}</b></div><div><small>ESTADO</small><b>{String(current.estado).replaceAll("_"," ")}</b></div></section>
    <AttendanceCheckInPanel s={s} active={active}/>
    <QuickPilotSearch s={s} active={active} q={quickQ||""} role="GRILLA" cat={current.categoria_fecha_id}/>
    <section className="opCard"><div className="opCardHead"><div><h2>SELECCIONAR CATEGORÍA</h2><p>La Grilla trabaja sobre una categoría a la vez.</p></div><span className="opBadge ok">{rows.length} INSCRITOS</span></div><div className="catTabs">{full.map((c:any)=><a className={c.categoria_fecha_id===current.categoria_fecha_id?"active":""} href={`/admin/master-drag/grilla?cat=${c.categoria_fecha_id}`} key={c.categoria_fecha_id}>{c.def?.codigo||c.def?.nombre}<small>{String(c.estado).replaceAll("_"," ")}</small></a>)}</div></section>
    <section className="opCard"><div className="opCardHead"><div><h2>INCORPORAR PILOTO</h2><p>Busca por RUT. Si es nuevo, se crea su ficha y número de temporada; luego se asigna categoría y vehículo.</p></div><span className="opBadge ok">GRILLA</span></div>
      <form action={addGrillaPilot} className="grillaForm"><input type="hidden" name="fecha_id" value={active.fecha_id}/><input type="hidden" name="temporada_id" value={temporadaId||""}/><input type="hidden" name="categoria_fecha_id" value={current.categoria_fecha_id}/>
        <label className="opField">RUT *<input name="rut" required placeholder="12.345.678-9"/></label><label className="opField">Número competencia *<input name="numero_competencia" inputMode="numeric" required placeholder="81"/></label><label className="opField">Nombres<input name="nombres" placeholder="Solo si es piloto nuevo"/></label><label className="opField">Apellidos<input name="apellidos" placeholder="Solo si es piloto nuevo"/></label><label className="opField">Marca vehículo<input name="marca" placeholder="Ej: BMW"/></label><label className="opField">Modelo<input name="modelo" placeholder="Ej: M240i"/></label><label className="opField">Patente<input name="patente" placeholder="Opcional"/></label><button className="opPrimary" type="submit">AGREGAR A {current.def?.codigo||"CATEGORÍA"}</button>
      </form><div className="opNote">La incorporación queda registrada en auditoría. Grilla no puede ingresar tiempos ni modificar decisiones deportivas.</div></section>
    <section className="opCard"><div className="opCardHead"><div><h2>PILOTOS DE LA CATEGORÍA</h2><p>Listado real leído desde Supabase.</p></div><span className="opBadge warn">{rows.filter((r:any)=>!r.primer_pique_oficial_at).length} PENDIENTES</span></div>{rows.length?<div className="pilotTable">{rows.map((r:any)=><div key={r.participacion_id}><b>#{r.pt?.numero_competencia??"—"}</b><span><strong>{r.pi?`${r.pi.nombres} ${r.pi.apellidos}`:"Piloto"}</strong><small>{r.v?[r.v.marca,r.v.modelo].filter(Boolean).join(" "):"Vehículo sin registrar"}</small></span><em>{r.primer_pique_oficial_at?"YA CORRIÓ":"PENDIENTE"}</em><form action={removeGrillaPilot}><input type="hidden" name="participacion_id" value={r.participacion_id}/><input type="hidden" name="fecha_id" value={active.fecha_id}/><button disabled={!!r.primer_pique_oficial_at} type="submit">ELIMINAR</button></form></div>)}</div>:<div className="notice"><b>Aún no hay pilotos inscritos en esta categoría.</b><span>Usa el formulario superior para agregar el primero.</span></div>}</section>
    <div className="roleRule">GRILLA · Gestiona inscritos y pendientes. No asigna pistas, no ingresa tiempos, no confirma piques y no modifica bracket ni decisiones deportivas.</div>
  </div>
}

async function QuickPilotSearch({s,active,q,role,cat}:{s:any,active:any,q:string,role:"GRILLA"|"CRONOMETRAJE",cat?:string}){
  const query=String(q||"").trim(); let pilots:any[]=[];
  