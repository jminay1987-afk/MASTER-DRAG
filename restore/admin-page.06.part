t("participacion_id,piloto_temporada_id").in("participacion_id",partIds);
  const ptIds=[...new Set((parts||[]).map((p:any)=>p.piloto_temporada_id))];const {data:pts}=ptIds.length?await s.from("piloto_temporada").select("piloto_temporada_id,piloto_id,numero_competencia").in("piloto_temporada_id",ptIds):{data:[]};
  const piIds=[...new Set((pts||[]).map((p:any)=>p.piloto_id))];const {data:pis}=piIds.length?await s.from("pilotos").select("piloto_id,nombres,apellidos").in("piloto_id",piIds):{data:[]};
  const {data:defs}=await s.from("categorias").select("categoria_id,codigo,nombre").in("categoria_id",[...new Set(seasonCf.map((x:any)=>x.categoria_id))]);
  const cfMap=new Map(seasonCf.map((x:any)=>[x.categoria_fecha_id,x]));const pm=new Map((parts||[]).map((x:any)=>[x.participacion_id,x]));const tm=new Map((pts||[]).map((x:any)=>[x.piloto_temporada_id,x]));const im=new Map((pis||[]).map((x:any)=>[x.piloto_id,x]));
  const groups=new Map<string,any[]>();
  for(const r of res){const cf:any=cfMap.get(r.categoria_fecha_id),part:any=pm.get(r.participacion_id),pt:any=part?tm.get(part.piloto_temporada_id):null;if(!cf||!pt)continue;const key=String(cf.categoria_id);if(!groups.has(key))groups.set(key,[]);let row=groups.get(key)!.find((x:any)=>x.piloto_temporada_id===pt.piloto_temporada_id);if(!row){const pi:any=im.get(pt.piloto_id);row={piloto_temporada_id:pt.piloto_temporada_id,numero:pt.numero_competencia,nombre:pi?`${pi.nombres} ${pi.apellidos}`:"Piloto",fechas:new Set(),base:0,bonos:0,total:0};groups.get(key)!.push(row);}row.fechas.add(cf.fecha_id);row.base+=Number(r.puntos_posicion||0);row.bonos+=Number(r.bono_exacto||0)+Number(r.bono_mejor_tiempo||0);row.total+=Number(r.puntos_totales||0);}
  const defMap=new Map((defs||[]).map((d:any)=>[String(d.categoria_id),d]));
  return <section className="opCard"><div className="opCardHead"><div><h2>RANKING ANUAL INTERNO</h2><p>Se recalcula automáticamente con puntuaciones confirmadas. Los empates exactos comparten posición provisional.</p></div><span className="opBadge ok">RANKING PROVISIONAL</span></div>{[...groups.entries()].map(([catId,rows])=>{rows.sort((a:any,b:any)=>b.total-a.total||a.numero-b.numero);let prev:number|null=null,pos=0;const ranked=rows.map((r:any,i:number)=>{if(prev===null||r.total!==prev)pos=i+1;prev=r.total;return {...r,pos}});const d:any=defMap.get(catId);return <div className="scoreBlock" key={catId}><h3>{d?.codigo||d?.nombre||"CATEGORÍA"}</h3><div className="scoreRows">{ranked.map((r:any)=><div key={r.piloto_temporada_id}><b>{r.pos}°</b><span>#{r.numero} · {r.nombre}</span><small>{r.fechas.size} fechas · Base {r.base} · Bonos {r.bonos}</small><strong>{r.total} pts</strong></div>)}</div><form action={publishRankingSnapshot} className="publishRankForm"><input type="hidden" name="temporada_id" value={temporadaId}/><input type="hidden" name="categoria_id" value={catId}/><button className="opPrimary">PUBLICAR RANKING ACTUALIZADO</button></form></div>})}</section>
}
async function ScoringPanel({s,cfs,defMap}:{s:any,cfs:any[],defMap:Map<any,any>}){
  const prov=cfs.filter((c:any)=>String(c.estado)==="PROVISIONAL"&&!c.puntuacion_confirmada);
  if(!prov.length)return null;
  const ids=prov.map((c:any)=>c.categoria_fecha_id);
  const {data:res}=await s.from("resultados_categoria").select("categoria_fecha_id,participacion_id,posicion,puntos_posicion,bono_exacto,bono_mejor_tiempo,puntos_totales,estado").in("categoria_fecha_id",ids).eq("estado","PROVISIONAL").order("posicion",{ascending:true});
  const partIds=(res||[]).map((r:any)=>r.participacion_id);
  const {data:parts}=partIds.length?await s.from("participaciones_categoria").select("participacion_id,piloto_temporada_id").in("participacion_id",partIds):{data:[]};
  const ptIds=(parts||[]).map((p:any)=>p.piloto_temporada_id);
  const {data:pts}=ptIds.length?await s.from("piloto_temporada").select("piloto_temporada_id,piloto_id,numero_competencia").in("piloto_temporada_id",ptIds):{data:[]};
  const piIds=(pts||[]).map((p:any)=>p.piloto_id);
  const {data:pis}=piIds.length?await s.from("pilotos").select("piloto_id,nombres,apellidos").in("piloto_id",piIds):{data:[]};
  const pm=new Map((parts||[]).map((x:any)=>[x.participacion_id,x]));const tm=new Map((pts||[]).map((x:any)=>[x.piloto_temporada_id,x]));const im=new Map((pis||[]).map((x:any)=>[x.piloto_id,x]));
  const label=(id:string)=>{const p:any=pm.get(id),t:any=p?tm.get(p.piloto_temporada_id):null,i:any=t?im.get(t.piloto_id):null;return `#${t?.numero_competencia??"—"} · ${i?`${i.nombres} ${i.apellidos}`:"Piloto"}`};
  return <section className="opCard"><div className="opCardHead"><div><h2>RESULTADOS Y PUNTUACIÓN PROVISIONAL</h2><p>El sistema calcula posiciones y bonos; Juez/Admin confirma antes de incorporarlos al campeonato.</p></div><span className="opBadge warn">PENDIENTE DE CONFIRMACIÓN</span></div>{prov.map((cf:any)=>{const def:any=defMap.get(cf.categoria_id);const rows=(res||[]).filter((r:any)=>r.categoria_fecha_id===cf.categoria_fecha_id);return <div className="scoreBlock" key={cf.categoria_fecha_id}><div className="opCardHead"><div><h3>{def?.codigo||def?.nombre||"CATEGORÍA"}</h3><p>{cf.participantes_oficiales} participantes oficiales · {cf.habilita_puntos?"ENTREGA PUNTOS":"SIN PUNTOS DE CAMPEONATO"}</p></div><form action={confirmCategoryScoring}><input type="hidden" name="categoria_fecha_id" value={cf.categoria_fecha_id}/><button className="opConfirm">CONFIRMAR PUNTUACIÓN</button></form></div><div className="scoreRows">{rows.map((r:any)=><div key={r.participacion_id}><b>{r.posicion?`${r.posicion}°`:"—"}</b><span>{label(r.participacion_id)}</span><small>Base {r.puntos_posicion} · Exacto +{r.bono_exacto} · Mejor +{r.bono_mejor_tiempo}</small><strong>{r.puntos_totales} pts</strong></div>)}</div></div>})}</section>
}


async function ContinuationVehiclePanel({s,active,cfs}:{s:any,active:any,cfs:any[]}){
  const cfIds=cfs.filter((c:any)=>!["PROVISIONAL","OFICIAL","NO_CONSIDERADA"].includes(String(c.estado))).map((c:any)=>c.categoria_fecha_id);
  if(!cfIds.length)return null;
  const {data:parts}=await s.from("participaciones_categoria").select("participacion_id,categoria_fecha_id,piloto_temporada_id,vehiculo_id").in("categoria_fecha_id",cfIds).eq("retiro_definitivo",false);
  if(!parts?.length)return null;
  const ptIds=[...new Set(parts.map((p:any)=>p.piloto_temporada_id))];const {data:pts}=await s.from("piloto_temporada").select("piloto_temporada_id,piloto_id,numero_competencia").in("piloto_temporada_id",ptIds);
  const piIds=[...new Set((pts||[]).map((p:any)=>p.piloto_id))];const {data:pis}=piIds.length?await s.from("pilotos").select("piloto_id,nombres,apellidos").in("piloto_id",piIds):{data:[]};
  const vehIds=[...new Set(parts.map((p:any)=>p.vehiculo_id).filter(Boolean))];const {data:vehs}=vehIds.length?await s.from("vehiculos").select("vehiculo_id,marca,modelo,patente").in("vehiculo_id",vehIds):{data:[]};
  const tm=new Map((pts||[]).map((x:any)=>[x.piloto_temporada_id,x]));const im=new Map((pis||[]).map((x:any)=>[x.piloto_id,x]));const vm=new Map((vehs||[]).map((x:any)=>[x.vehiculo_id,x]));
  const {data:laneRefs}=await s.from("pique_pilotos").select("participacion_id,pique_id").in("participacion_id",parts.map((p:any)=>p.participacion_id));const piqueIds=[...new Set((laneRefs||[]).map((x:any)=>x.pique_id))];const {data:contPiques}=piqueIds.length?await s.from("piques").select("pique_id,iniciado_at").in("pique_id",piqueIds).gte("iniciado_at",active.continuation_started_at).not("iniciado_at","is",null):{data:[]};const startedIds=new Set((contPiques||[]).map((x:any)=>x.pique_id));const fixed=new Set((laneRefs||[]).filter((x:any)=>startedIds.has(x.pique_id)).map((x:any)=>x.participacion_id));
  return <section className="opCard"><div className="opCardHead"><div><h2>VEHÍCULOS · CONTINUACIÓN</h2><p>El Juez puede cambiar el vehículo hasta antes del primer pique oficial del piloto en esta jornada. Los piques anteriores conservan el vehículo histórico utilizado.</p></div><span className="opBadge warn">REGLA ESPECIAL</span></div><div className="continuationVehicleRows">{parts.map((p:any)=>{const pt:any=tm.get(p.piloto_temporada_id),pi:any=pt?im.get(pt.piloto_id):null,v:any=p.vehiculo_id?vm.get(p.vehiculo_id):null,isFixed=fixed.has(p.participacion_id);return <article key={p.participacion_id}><div><b>#{pt?.numero_competencia??"—"} · {pi?`${pi.nombres} ${pi.apellidos}`:"Piloto"}</b><span>{v?[v.marca,v.modelo,v.patente].filter(Boolean).join(" · "):"Vehículo sin registrar"}</span></div>{isFixed?<strong>VEHÍCULO FIJADO</strong>:<form action={changeContinuationVehicle}><input type="hidden" name="participacion_id" value={p.participacion_id}/><input name="marca" placeholder="Marca"/><input name="modelo" placeholder="Modelo"/><input name="patente" placeholder="Patente"/><button className="opSecondary">CAMBIAR VEHÍCULO</button></form>}</article>})}</div></section>;
}

function SuspensionPanel({active}:{active:any}){
  const state=String(active?.estado||"");
  if(!active||state==="CERRADA_DEFINITIVAMENTE") return null;
  const used=Number(active.suspension_count||0)>=1;
  if(state==="SUSPENDIDA") return <section className="opCard suspensionCard"><div className="opCardHead"><div><h2>FECHA SUSPENDIDA</h2><p>La competencia deportiva está congelada. Piques, resultados y bracket permanecen guardados exactamente como estaban.</p></div><span className="opBadge warn">CONTINUACIÓN PENDIENTE</span></div><div className="notice"><b>MOTIVO DE SUSPENSIÓN</b><span>{active.suspension_reason||"Motivo registrado en auditoría"}</span></div><form action={startContinuationDay} className="continueDateForm"><input type="hidden" name="fecha_id" value={active.fecha_id}/><label className="opField">Fecha calendario de continuación<input type="date" name="continuation_date" required/></label><button className="opConfirm">INICIAR DÍA DE CONTINUACIÓN</button><small>Esta será la única jornada de continuación permitida para esta fecha oficial.</small></form></section>;
  if(state==="CONTINUACION") return <section className="opCard suspensionCard"><div className="opCardHead"><div><h2>JORNADA DE CONTINUACIÓN</h2><p>Se reanudó la misma fecha oficial conservando rondas, piques, pilotos activos y bracket.</p></div><span className="opBadge ok">CONTINUACIÓN ACTIVA</span></div><div className="closureStats"><div><small>FECHA CALENDARIO</small><b>{active.continuation_date||"Registrada"}</b></div><div><small>SUSPENSIONES USADAS</small><b>1 / 1</b></div><div><small>NUEVA SUSPENSIÓN</small><b>NO PERMITIDA</b></div></div></section>;
  if(used) return null;
  return <section className="opCard suspensionCard"><div className="opCardHead"><div><h2>SUSPENSIÓN DE FECHA</h2><p>Solo Juez/Admin. La suspensión congela la competencia sin borrar datos y habilita una única jornada de continuación.</p></div><span className="opBadge">DISPONIBLE 1 VEZ</span></div><form action={suspendDate} className="suspendDateForm"><input type="hidden" name="fecha_id" value={active.fecha_id}/><label className="opField">Motivo de suspensión<textarea name="motivo" required placeholder="Ej.: condiciones climáticas que impiden continuar con seguridad"/></label><button className="opSecondary">SUSPENDER FECHA</button><small>Las categorías terminadas conservan sus resultados. Las incompletas quedan congeladas; las no iniciadas permanecen pendientes.</small></form></section>;
}

async function DateClosurePanel({s,active,cfs,defMap}:{s:any,active:any,cfs:any[],defMap:Map<any,any>}){
  const cfIds=cfs.map((x:any)=>x.categoria_fecha_id);
  const {data:piques}=cfIds.length?await s.from("piques").select("pique_id,categoria_fecha_id,estado,decision_juez_pendiente").in("categoria_fecha_id",cfIds):{data:[]};
  const unresolved=(piques||[]).filter((p:any)=>p.decision_juez_pendiente||!["CONFIRMADO","ANULADO"].includes(String(p.estado))).length;
  const incomplete=cfs.filter((c:any)=>!["OFICIAL","NO_CONSIDERADA"].includes(String(c.estado)));
  const scoringPending=cfs.filter((c:any)=>String(c.estado)==="OFICIAL"&&!c.puntuaci