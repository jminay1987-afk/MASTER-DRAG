ClosurePanel s={s} active={active} cfs={cfs||[]} defMap={defMap}/>;
  if(!pique)return <div className="operatorPanel"><section className="opSummary"><div><small>EVENTO ACTIVO</small><b>{active.nombre}</b></div><div><small>REVISIONES PENDIENTES</small><b>0</b></div><div><small>ESTADO</small><b>SIN INCIDENCIAS</b></div></section><section className="opCard"><div className="notice"><b>No hay piques enviados a revisión.</b><span>Cuando Cronometraje use ENVIAR A JUEZ aparecerá aquí el mismo pique con todos sus datos.</span></div></section>{attendance}{scoring}{championship}{suspension}{continuationVehicles}{closure}<AuditRows rows={audit||[]}/><div className="roleRule">JUEZ · Autoridad deportiva: revisa, corrige y confirma decisiones con trazabilidad.</div></div>;
  const cf:any=cfMap.get(pique.categoria_fecha_id);const cat:any=cf?defMap.get(cf.categoria_id):null;
  const {data:lanes}=await s.from("pique_pilotos").select("pique_piloto_id,participacion_id,pista,tiempo_final_s,reaccion_s,tiempo_60ft_s,tiempo_100m_s,velocidad_final_kmh,condicion,paso_primero_meta,gana_pique").eq("pique_id",pique.pique_id).order("pista");
  const partIds=(lanes||[]).map((x:any)=>x.participacion_id);const {data:parts}=partIds.length?await s.from("participaciones_categoria").select("participacion_id,piloto_temporada_id").in("participacion_id",partIds):{data:[]};
  const ptIds=(parts||[]).map((x:any)=>x.piloto_temporada_id);const {data:pts}=ptIds.length?await s.from("piloto_temporada").select("piloto_temporada_id,piloto_id,numero_competencia").in("piloto_temporada_id",ptIds):{data:[]};
  const piIds=(pts||[]).map((x:any)=>x.piloto_id);const {data:pis}=piIds.length?await s.from("pilotos").select("piloto_id,nombres,apellidos").in("piloto_id",piIds):{data:[]};
  const pMap=new Map((parts||[]).map((x:any)=>[x.participacion_id,x]));const ptMap=new Map((pts||[]).map((x:any)=>[x.piloto_temporada_id,x]));const piMap=new Map((pis||[]).map((x:any)=>[x.piloto_id,x]));
  const rows=(lanes||[]).map((l:any)=>{const part:any=pMap.get(l.participacion_id);const pt:any=part?ptMap.get(part.piloto_temporada_id):null;const pi:any=pt?piMap.get(pt.piloto_id):null;return {...l,label:`#${pt?.numero_competencia??"—"} · ${pi?`${pi.nombres} ${pi.apellidos}`:"Piloto"}`}});
  return <div className="operatorPanel">
    <section className="opSummary"><div><small>EVENTO ACTIVO</small><b>{active.nombre}</b></div><div><small>CATEGORÍA</small><b>{cat?.codigo||cat?.nombre||"—"}</b></div><div><small>REVISIONES PENDIENTES</small><b>{reviews?.length||0}</b></div></section>
    <QuickPilotSearch s={s} active={active} q={quickQ||""} role="CRONOMETRAJE" cat={current.categoria_fecha_id}/>
    <section className="judgeGrid"><article className="opCard"><div className="opCardHead"><div><h2>{pique.correlativo?`PIQUE #${pique.correlativo}`:"PIQUE EN REVISIÓN"}</h2><p>{String(pique.ronda).replaceAll("_"," ")} · Motivo: {pique.motivo_revision||"Sin motivo informado"}</p></div><span className="opBadge danger">EN REVISIÓN</span></div>
      <div className="judgePique">{rows.map((l:any)=><div key={l.pique_piloto_id}><small>{String(l.pista).replace("_"," ")}</small><b>{l.label}</b><strong>{l.tiempo_final_s!=null?Number(l.tiempo_final_s).toFixed(3):"---.---"}</strong><span>{l.condicion?String(l.condicion).replaceAll("_"," "):"SIN RESULTADO"}</span><em>R {l.reaccion_s!=null?Number(l.reaccion_s).toFixed(3):"—"} · 60ft {l.tiempo_60ft_s!=null?Number(l.tiempo_60ft_s).toFixed(3):"—"} · 100m {l.tiempo_100m_s!=null?Number(l.tiempo_100m_s).toFixed(3):"—"} · {l.velocidad_final_kmh!=null?`${Number(l.velocidad_final_kmh).toFixed(1)} km/h`:"—"}</em></div>)}</div>
      <form action={judgeResolvePique} className="judgeDecisionForm"><input type="hidden" name="pique_id" value={pique.pique_id}/><input type="hidden" name="categoria_limite" value={cat?.tiempo_limite_s??""}/>{rows.map((l:any)=><fieldset key={l.pique_piloto_id}><legend>{l.label}</legend><input type="hidden" name={`lane_${l.pique_piloto_id}`} value={l.participacion_id}/><label className="opField">Tiempo final<input name={`tiempo_${l.pique_piloto_id}`} inputMode="decimal" defaultValue={l.tiempo_final_s!=null?Number(l.tiempo_final_s).toFixed(3):""}/></label><label className="opField">Condición<select name={`condicion_${l.pique_piloto_id}`} defaultValue={l.condicion||"SIN_TIEMPO"}><option value="VALIDO">VÁLIDO</option><option value="CAIDO">CAÍDO</option><option value="MADRUGAZO">MADRUGAZO</option><option value="NO_LARGA">NO LARGA</option><option value="LINEA_CENTRAL">LÍNEA CENTRAL</option><option value="SIN_TIEMPO">SIN TIEMPO</option></select></label></fieldset>)}
        <label className="opField">Decisión<select name="outcome" defaultValue={pique.ganador_participacion_id||"SIN_GANADOR"}><option value="SIN_GANADOR">SIN GANADOR</option>{rows.map((l:any)=><option value={l.participacion_id} key={l.participacion_id}>{l.label}</option>)}</select></label><label className="opField">Fundamento / observación<textarea name="motivo" required placeholder="Fundamento de la decisión del Juez"/></label><button className="opConfirm">CONFIRMAR DECISIÓN DEL JUEZ</button>
      </form>
      <form action={judgeTechnicalRepeat} className="reviewForm"><input type="hidden" name="pique_id" value={pique.pique_id}/><input name="motivo" required placeholder="Motivo de repetición técnica"/><button className="opSecondary">ORDENAR REPETICIÓN TÉCNICA</button></form>
    </article><article className="opCard"><h2>DATOS RECIBIDOS DE CRONOMETRAJE</h2><p className="judgeInfo">El Juez está viendo exactamente el registro del pique enviado por Cronometraje. Puede corregir tiempo/condición, definir el ganador o disponer una repetición técnica. Toda modificación exige fundamento.</p><div className="judgeQueue"><b>COLA DE REVISIÓN</b>{(reviews||[]).map((r:any)=><span key={r.pique_id}>#{r.correlativo||"—"} · {String(r.ronda).replaceAll("_"," ")} · {r.motivo_revision||"Revisión"}</span>)}</div></article></section>
    {attendance}{scoring}{championship}{suspension}{continuationVehicles}{closure}<AuditRows rows={audit||[]}/><div className="roleRule">JUEZ · Autoridad deportiva: puede revisar, corregir, ordenar repetición y confirmar decisiones con trazabilidad y motivo obligatorio.</div>
  </div>
}

async function AttendanceCheckInPanel({s,active}:{s:any,active:any}){
  if(!active?.temporada_id)return null;
  const {count}=await s.from("asistencias_fecha").select("asistencia_id",{count:"exact",head:true}).eq("fecha_id",active.fecha_id).eq("asistio",true);
  return <section className="opCard attendanceQuick"><div className="opCardHead"><div><h2>CHECK-IN / ASISTENCIA</h2><p>La asistencia pertenece al piloto y a la fecha completa. No depende del vehículo ni de cuántas categorías corra.</p></div><span className="opBadge ok">{count||0} PRESENTES</span></div><form action={setPilotAttendance} className="attendanceCheckForm"><input type="hidden" name="fecha_id" value={active.fecha_id}/><label className="opField">RUT del piloto<input name="rut" required placeholder="12.345.678-9"/></label><button className="opConfirm">REGISTRAR CHECK-IN</button></form>{String(active.estado)==="CONTINUACION"?<div className="notice"><b>CONTINUACIÓN</b><span>Un piloto que llega recién en la continuación debe ser validado por Juez/Admin y aún poder incorporarse a una categoría abierta.</span></div>:null}</section>;
}

async function AttendancePanel({s,active}:{s:any,active:any}){
  if(!active?.temporada_id)return null;
  const {data:season}=await s.from("temporadas").select("temporada_id,anio,nombre,min_asistencias_premio").eq("temporada_id",active.temporada_id).single();
  const min=Number(season?.min_asistencias_premio??7);
  const {data:pts}=await s.from("piloto_temporada").select("piloto_temporada_id,piloto_id,numero_competencia").eq("temporada_id",active.temporada_id).eq("estado","ACTIVO").order("numero_competencia");
  const pilotoIds=(pts||[]).map((x:any)=>x.piloto_id);
  const {data:pis}=pilotoIds.length?await s.from("pilotos").select("piloto_id,rut,nombres,apellidos").in("piloto_id",pilotoIds):{data:[]};
  const {data:seasonDates}=await s.from("fechas").select("fecha_id").eq("temporada_id",active.temporada_id).eq("tipo_evento","MASTER_DRAG");
  const dateIds=(seasonDates||[]).map((x:any)=>x.fecha_id);
  const {data:att}=dateIds.length&&pilotoIds.length?await s.from("asistencias_fecha").select("asistencia_id,fecha_id,piloto_id,asistio,origen_asistencia").in("fecha_id",dateIds).in("piloto_id",pilotoIds):{data:[]};
  const presentNow=new Map((att||[]).filter((x:any)=>x.fecha_id===active.fecha_id).map((x:any)=>[x.piloto_id,x]));
  const counts=new Map<string,number>(); for(const r of att||[])if(r.asistio)counts.set(r.piloto_id,(counts.get(r.piloto_id)||0)+1);
  const piMap=new Map((pis||[]).map((x:any)=>[x.piloto_id,x]));
  return <section className="opCard attendancePanel"><div className="opCardHead"><div><h2>ASISTENCIA Y CHECK-IN</h2><p>Check-in una sola vez por piloto/fecha. La participación efectiva también genera asistencia; una simple inscripción no.</p></div><span className="opBadge ok">MÍNIMO ANUAL {min}</span></div>
    <div className="attendanceTop"><form action={setPilotAttendance} className="attendanceCheckForm"><input type="hidden" name="fecha_id" value={active.fecha_id}/><label className="opField">RUT del piloto<input name="rut" required placeholder="12.345.678-9"/></label><button className="opConfirm">REGISTRAR CHECK-IN</button></form><form action={updateSeasonAttendanceMinimum} className="minimumForm"><input type="hidden" name="temporada_id" value={active.temporada_id}/><label className="opField">Mínimo de fechas para premio anual<input type="number" min="0" max="99" name="minimo" defaultValue={min} required/></label><button className="opSecondary">ACTUALIZAR MÍNIMO</button></form></div>
    <div className="attendanceRows">{(pts||[]).map((pt:any)=>{const pi:any=piMap.get(pt.piloto_id);const row:any=presentNow.get(pt.piloto_id);const total=counts.get(pt.piloto_id)||0;return <article key={pt.piloto_temporada_id}><div><b>#{pt.numero_competencia} · {pi?`${pi.nombres} ${pi.apellidos}`:"Piloto"}</b><span>{pi?.rut||"RUT —"} · {row?.asistio?`PRESENTE · ${String(row.origen_asistencia||"").replaceAll("_"," ")}`:"SIN ASISTENCIA EN ESTA FECHA"}</span></div><div className="attendanceStatus"><strong className={total>=min?"okText":""}>{total} / {min} fechas</strong><small>{total>=min?"HABILITADO PARA PREMIO ANUAL":"AÚN NO HABILITADO"}</small></div><form action={judgeOverrideAttendance} className="attendanceOverride"><input type="hidden" name="fecha_id" value={active.fecha_id}/><input type="hidden" name="piloto_id" value={pt.piloto_id}/><select name="asistio" defaultValue={row?.asistio?"SI":"NO"}><option value="SI">PRESENTE</option><option value="NO">AUSENTE</option></select><input name="motivo" required placeholder="Motivo obligatorio"/><button className="opSecondary">AJUSTAR</button></form></article>})}</div>
  </section>;
}

async function ChampionshipPanel({s,temporadaId}:{s:any,temporadaId:string|null}){
  if(!temporadaId)return null;
  const {data:cfs}=await s.from("categoria_fecha").select("categoria_fecha_id,categoria_id,fecha_id,puntuacion_confirmada").eq("puntuacion_confirmada",true);
  const seasonCf:any[]=[];
  if(cfs?.length){const fechaIds=[...new Set(cfs.map((x:any)=>x.fecha_id))];const {data:fechas}=await s.from("fechas").select("fecha_id").eq("temporada_id",temporadaId).in("fecha_id",fechaIds);const set=new Set((fechas||[]).map((x:any)=>x.fecha_id));seasonCf.push(...cfs.filter((x:any)=>set.has(x.fecha_id)));}
  if(!seasonCf.length)return null;
  const cfIds=seasonCf.map((x:any)=>x.categoria_fecha_id);
  const {data:res}=await s.from("resultados_categoria").select("categoria_fecha_id,participacion_id,puntos_posicion,bono_exacto,bono_mejor_tiempo,puntos_totales").in("categoria_fecha_id",cfIds).eq("estado","OFICIAL");
  if(!res?.length)return null;
  const partIds=res.map((r:any)=>r.participacion_id);const {data:parts}=await s.from("participaciones_categoria").selec