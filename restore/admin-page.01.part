import {notFound,redirect} from "next/navigation";import {operator,allowed,type Role} from "@/lib/admin";import {logout} from "@/app/login/actions";import {addGrillaPilot,removeGrillaPilot,prepareCronoPique,markPiqueReady,startCronoPique,saveCronoResult,confirmCronoPique,sendPiqueToJudge,judgeResolvePique,judgeTechnicalRepeat,confirmCategoryScoring,publishRankingSnapshot,markCategoryNotConsidered,closeDateDefinitely,suspendDate,startContinuationDay,changeContinuationVehicle,setPilotAttendance,judgeOverrideAttendance,updateSeasonAttendanceMinimum,cancelPrestartPique} from "@/app/admin/actions";
const C={"master-drag":{title:"MASTER DRAG",type:"MASTER_DRAG",roles:["GRILLA","CRONOMETRAJE","JUEZ"] as Role[]},"time-attack":{title:"TIME ATTACK",type:"TIME_ATTACK",roles:["CRONOMETRAJE","JUEZ"] as Role[]},"fecha-independiente":{title:"FECHA INDEPENDIENTE",type:"INDEPENDIENTE",roles:["CRONOMETRAJE","JUEZ"] as Role[]}};const map:Record<string,Role>={grilla:"GRILLA",cronometraje:"CRONOMETRAJE",juez:"JUEZ"};
export default async function Admin({params,searchParams}:{params:Promise<{parts?:string[]}>,searchParams:Promise<{cat?:string,q?:string,pilot?:string}>}){const {parts=[]}=await params;const qs=await searchParams;const {s,u}=await operator();if(!parts.length)return <Frame u={u}><p className="redline">ÁREA PRIVADA</p><h1>PANEL DE ADMINISTRACIÓN</h1><p className="introAdmin">Selecciona el tipo de competencia que vas a operar.</p><div className="compGrid"><Comp href="/admin/master-drag" title="MASTER DRAG" roles="GRILLA · CRONOMETRAJE · JUEZ"/><Comp href="/admin/time-attack" title="TIME ATTACK" roles="CRONOMETRAJE · JUEZ"/><Comp href="/admin/fecha-independiente" title="FECHA INDEPENDIENTE" roles="CRONOMETRAJE · JUEZ"/></div><div className="adminnote"><b>Orden correcto:</b> competencia → fecha/evento → cargo autorizado. Grilla existe únicamente en Master Drag.</div></Frame>;const c=C[parts[0] as keyof typeof C];if(!c)notFound();if(parts.length===1){const {data:dates}=await s.from("fechas").select("fecha_id,nombre,numero_oficial,fecha_calendario_principal,autodromo,estado").eq("tipo_evento",c.type).order("fecha_calendario_principal",{ascending:false}).limit(8);return <Frame u={u} back="/admin"><p className="redline">PANEL OPERATIVO</p><h1>{c.title}</h1><p className="introAdmin">Elige el cargo con el que vas a trabajar.</p><div className={`roleGrid r${c.roles.length}`}>{c.roles.map(r=>allowed(u.rol_global,r as Exclude<Role,"ADMIN_PRINCIPAL">)?<a className="role" href={`/admin/${parts[0]}/${r.toLowerCase()}`} key={r}><i>{r==="GRILLA"?"01":r==="CRONOMETRAJE"?"02":"03"}</i><h2>{r}</h2><p>{desc(r)}</p><b>ENTRAR →</b></a>:<article className="role disabled" key={r}><h2>{r}</h2><p>Sin acceso para este usuario.</p></article>)}</div>{parts[0]==="master-drag"&&allowed(u.rol_global,"JUEZ")?<a className="pilotHistoryEntry" href="/admin/master-drag/pilotos"><div><small>CONSULTA DEPORTIVA</small><h2>FICHA DEL PILOTO / HISTORIAL</h2><p>Buscar por RUT, nombre o número de competencia. Solo lectura.</p></div><b>ABRIR FICHA →</b></a>:null}<div className="eventbox"><p className="redline">FECHAS / EVENTOS</p><h2>ACTIVIDAD REGISTRADA</h2>{dates?.length?<div className="eventlist">{dates.map(d=><article key={d.fecha_id}><div><b>{d.nombre||`${d.numero_oficial||""}ª FECHA`}</b><span>{d.autodromo||"Lugar por definir"}</span></div><small>{String(d.estado).replaceAll("_"," ")}</small></article>)}</div>:<div className="notice"><b>Aún no hay eventos de {c.title} cargados.</b><span>La estructura ya está conectada a Supabase.</span></div>}</div></Frame>}if(parts[0]==="master-drag"&&parts[1]==="pilotos"){if(!allowed(u.rol_global,"JUEZ"))redirect("/admin/master-drag");return <Frame u={u} back="/admin/master-drag"><PilotHistoryPanel s={s} q={qs.q||""} pilotId={qs.pilot||""}/></Frame>}const role=map[parts[1]];if(!role||!c.roles.includes(role))notFound();if(!allowed(u.rol_global,role as Exclude<Role,"ADMIN_PRINCIPAL">))redirect(`/admin/${parts[0]}`);const {data:dates}=await s.from("fechas").select("fecha_id,temporada_id,nombre,autodromo,estado,suspension_count,suspended_at,suspension_reason,continuation_started_at,continuation_date").eq("tipo_evento",c.type).order("fecha_calendario_principal",{ascending:false}).limit(10);const active=dates?.find(d=>["EN_COMPETENCIA","CONTINUACION","SUSPENDIDA","PREPARACION"].includes(String(d.estado)))||dates?.[0];return <Frame u={u} back={`/admin/${parts[0]}`}><div className="moduleHead"><div><p className="redline">{c.title}</p><h1>{role}</h1><p className="introAdmin">Módulo operativo recuperado e integrado a la arquitectura actual.</p></div><aside><small>EVENTO ACTIVO</small><b>{active?.nombre||"7ª FECHA MASTER DRAG"}</b><span>{active?.autodromo||"AUTÓDROMO SAN ANTONIO"}</span></aside></div>{role==="GRILLA"?<GrillaPanel s={s} active={active} selectedCat={qs.cat} quickQ={qs.q||""}/>:role==="CRONOMETRAJE"?<CronoPanel s={s} active={active} selectedCat={qs.cat} quickQ={qs.q||""}/>:<JuezPanel s={s} active={active}/>}</Frame>}
function Frame({u,children,back}:{u:any,children:React.ReactNode,back?:string}){return <main className="admin"><header><div className="wrap"><a className="brand" href="/"><i>MASTER</i> DRAG</a><div>{back?<a href={back}>← VOLVER</a>:null}<span>{u.nombre} · {String(u.rol_global).replaceAll("_"," ")}</span><form action={logout}><button>SALIR</button></form></div></div></header><section className="wrap adminBody">{children}</section></main>};function Comp({href,title,roles}:{href:string,title:string,roles:string}){return <a className="comp" href={href}><small>COMPETENCIA</small><h2>{title}</h2><p>{roles}</p><b>SELECCIONAR →</b></a>};function desc(r:string){return r==="GRILLA"?"Pregrilla, emparejamientos, rondas y orden de salida.":r==="CRONOMETRAJE"?"Registro de pasadas y tiempos con tres decimales.":"Validación deportiva, incidencias y confirmación de resultados."};function Module({n,title,text}:{n:string,title:string,text:string}){return <article><i>{n}</i><h2>{title}</h2><p>{text}</p><b>ESTRUCTURA LISTA</b></article>}

function SummaryStrip(){return <section className="opSummary"><div><small>EVENTO ACTIVO</small><b>7ª FECHA MASTER DRAG</b></div><div><small>CATEGORÍA ACTIVA</small><b>9.5 SEG</b></div><div><small>ETAPA ACTIVA</small><b>PRIMERA RONDA</b></div></section>}
function Pending(){return <section className="opCard"><div className="opCardHead"><div><h2>PENDIENTES</h2><p>Pilotos que aún no han entrado en la etapa activa.</p></div><span className="opBadge warn">6 PENDIENTES</span></div><div className="pilotChips">{[[81,"Cristian Valderrama"],[131,"Gonzalo Silva"],[24,"Eduardo Zamora"],[44,"Christopher Pérez"],[76,"Piloto 76"],[102,"Piloto 102"]].map(([n,name])=><button key={n} title={String(name)}>#{n}</button>)}</div></section>}

async function PilotHistoryPanel({s,q,pilotId}:{s:any,q:string,pilotId:string}){
  const query=String(q||"").trim();
  let matches:any[]=[];
  if(query){
    const safe=query.replaceAll(","," ");
    const {data:base}=await s.from("pilotos").select("piloto_id,rut,nombres,apellidos,telefono,email,estado").or(`rut.ilike.%${safe}%,nombres.ilike.%${safe}%,apellidos.ilike.%${safe}%`).limit(20);
    const byId=new Map((base||[]).map((x:any)=>[x.piloto_id,x]));
    const n=Number(query.replace(/\D/g,""));
    if(Number.isFinite(n)&&n>0){const {data:numRows}=await s.from("piloto_temporada").select("piloto_id").eq("numero_competencia",n).limit(20);const ids=(numRows||[]).map((x:any)=>x.piloto_id).filter((id:string)=>!byId.has(id));if(ids.length){const {data:extra}=await s.from("pilotos").select("piloto_id,rut,nombres,apellidos,telefono,email,estado").in("piloto_id",ids);for(const x of extra||[])byId.set(x.piloto_id,x)}}
    matches=[...byId.values()];
  }
  let pilot:any=null;
  if(pilotId){const {data}=await s.from("pilotos").select("piloto_id,rut,nombres,apellidos,telefono,email,fecha_nacimiento,estado,created_at").eq("piloto_id",pilotId).maybeSingle();pilot=data||null;}
  return <div className="operatorPanel pilotHistoryPanel"><div className="moduleHead"><div><p className="redline">MASTER DRAG · CONSULTA INTERNA</p><h1>FICHA DEL PILOTO</h1><p className="introAdmin">Consulta deportiva de solo lectura. Busca por RUT, nombre, apellido o número de competencia.</p></div><aside><small>ACCESO</small><b>JUEZ / ADMIN</b><span>HISTORIAL Y TRAZABILIDAD</span></aside></div>
    <section className="opCard pilotSearchCard"><form method="get" className="pilotSearchForm"><label className="opField">Buscar piloto<input name="q" defaultValue={query} placeholder="RUT, nombre o # competencia" autoComplete="off"/></label><button className="opPrimary" type="submit">BUSCAR</button></form>{query?<div className="pilotSearchResults">{matches.length?matches.map((m:any)=><a key={m.piloto_id} href={`/admin/master-drag/pilotos?q=${encodeURIComponent(query)}&pilot=${m.piloto_id}`} className={pilotId===m.piloto_id?"active":""}><b>{m.nombres} {m.apellidos}</b><span>{m.rut}</span><small>{m.estado}</small></a>):<div className="notice compact"><b>Sin coincidencias</b><span>No existen pilotos registrados que coincidan con “{query}”.</span></div>}</div>:<div className="notice compact"><b>BÚSQUEDA DE SOLO LECTURA</b><span>La ficha no crea ni modifica pilotos. Los datos aparecerán cuando existan registros reales.</span></div>}</section>
    {pilot?<PilotHistoryDetail s={s} pilot={pilot}/>:null}
  </div>
}
async function PilotHistoryDetail({s,pilot}:{s:any,pilot:any}){
  const {data:seasonRows}=await s.from("piloto_temporada").select("piloto_temporada_id,temporada_id,numero_competencia,estado,fecha_incorporacion").eq("piloto_id",pilot.piloto_id).order("fecha_incorporacion",{ascending:false});
  const seasonIds=[...new Set((seasonRows||[]).map((x:any)=>x.temporada_id))];
  const {data:seasons}=seasonIds.length?await s.from("temporadas").select("temporada_id,anio,nombre,estado,min_asistencias_premio").in("temporada_id",seasonIds):{data:[]};
  const sm=new Map((seasons||[]).map((x:any)=>[x.temporada_id,x]));
  const {data:atts}=await s.from("asistencias_fecha").select("fecha_id,asistio,origen_asistencia").eq("piloto_id",pilot.piloto_id).eq("asistio",true);
  const attFechaIds=[...new Set((atts||[]).map((x:any)=>x.fecha_id))];
  const ptIds=(seasonRows||[]).map((x:any)=>x.piloto_temporada_id);
  const {data:parts}=ptIds.length?await s.from("participaciones_categoria").select("participacion_id,categoria_fecha_id,piloto_temporada_id,vehiculo_id,estado,participacion_deportiva,retiro_definitivo,primer_pique_oficial_at").in("piloto_temporada_id",ptIds):{data:[]};
  const cfIds=[...new Set((parts||[]).map((x:any)=>x.categoria_fecha_id))];
  const {data:cfs}=cfIds.length?await s.from("categoria_fecha").select("categoria_fecha_id,fecha_id,categoria_id,estado,habilita_puntos,puntuacion_confirmada").in("categoria_fecha_id",cfIds):{data:[]};
  const fechaIds=[...new Set([...(cfs||[]).map((x:any)=>x.fecha_id),...attFechaIds])];
  const {data:dates}=fechaIds.length?await s.from("fechas").select("fecha_id,temporada_id,numero_oficial,nombre,fecha_calendario_principal,autodromo,tipo_evento,estado").in("fecha_id",fechaIds):{data:[]};
  const catIds=[...new Set((cfs||[]).map((x:any)=>x.categoria_id))];
  const {data:cats}=catIds.length?await s.from("categorias").select("categoria_id,codigo,nombre,tiempo_limite_s").in("categoria_id",catIds):{data:[]};
  const partIds=(parts||[]).map((x:any)=>x.participacion_id);
  const {data:results}=partIds.length?await s.from("resultados_categoria").select("categoria_fecha_id,participacion_id,posicion,puntos_posicion,bono_exacto,bono_mejor_tiempo,puntos_totales,estado").in("participacion_id",partIds).order("posicion",{ascending:true}):{data:[]};
  const {data:lanes}=partIds.length?await s.from("pique_pilotos").select("pique_piloto_id,pique_id,participacion_id,pista,tiempo_final_s,reaccion_s,tiempo_60ft_s,tiempo_100m_s,velocidad_final_kmh,condicion,gana_pique,vehiculo_id").in("participacion_id",partIds):{data:[]};
  const piqueIds=[...new Set((lanes||[]).map((x:any)=>x.pique