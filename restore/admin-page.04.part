e={c.categoria_fecha_id===current.categoria_fecha_id?"active":""} href={`/admin/master-drag/cronometraje?cat=${c.categoria_fecha_id}`} key={c.categoria_fecha_id}>{c.def?.codigo||c.def?.nombre}<small>{String(c.estado).replaceAll("_"," ")}</small></a>)}</div></section>
  {!pique?<section className="opCard"><div className="opCardHead"><div><h2>PREPARAR PIQUE</h2><p>El sistema determina la etapa activa. El correlativo nace recién al iniciar oficialmente la largada.</p></div><span className="opBadge warn">{String(current.estado).replaceAll("_"," ")}</span></div>{String(current.estado)==="MATA_MATA"?(pendingBracket.length?<div className="bracketQueue">{pendingBracket.map((n:any)=><form action={prepareCronoPique} className="bracketMatch" key={n.bracket_nodo_id}><input type="hidden" name="categoria_fecha_id" value={current.categoria_fecha_id}/><input type="hidden" name="ronda" value={n.ronda}/><input type="hidden" name="pista_1" value={n.participacion_a_id}/><input type="hidden" name="pista_2" value={n.participacion_b_id}/><div><small>{String(n.ronda).replaceAll("_"," ")} · CRUCE {n.orden_nodo}</small><b>{labelById.get(n.participacion_a_id)||"Piloto"}</b><span>VS</span><b>{labelById.get(n.participacion_b_id)||"Piloto"}</b></div><button className="opPrimary" type="submit">PREPARAR ESTE CRUCE</button></form>)}</div>:<div className="notice"><b>No hay cruces pendientes.</b><span>El bracket avanzará al siguiente nivel cuando se confirmen todos los piques de la ronda.</span></div>):rows.length?<form action={prepareCronoPique} className="cronoPrepare"><input type="hidden" name="categoria_fecha_id" value={current.categoria_fecha_id}/><input type="hidden" name="ronda" value={String(current.estado)==="PERDEDORES"?"PERDEDORES":"PRIMERA"}/><label className="opField">Etapa<input readOnly value={String(current.estado)==="PERDEDORES"?"PERDEDORES":"PRIMERA RONDA"}/></label><label className="opField">PISTA 1<select name="pista_1" required><option value="">Seleccionar piloto</option>{rows.filter((r:any)=>String(current.estado)==="PERDEDORES"?r.estado==="PERDEDORES":["INSCRITO","PRIMERA_RONDA"].includes(r.estado)).map((r:any)=><option key={r.participacion_id} value={r.participacion_id}>{r.label}</option>)}</select></label><label className="opField">PISTA 2<select name="pista_2"><option value="">Sin rival / pasada individual</option>{rows.filter((r:any)=>String(current.estado)==="PERDEDORES"?r.estado==="PERDEDORES":["INSCRITO","PRIMERA_RONDA"].includes(r.estado)).map((r:any)=><option key={r.participacion_id} value={r.participacion_id}>{r.label}</option>)}</select></label><button className="opPrimary" type="submit">PREPARAR PIQUE</button></form>:<div className="notice"><b>No hay pilotos disponibles en esta categoría.</b><span>Primero deben incorporarse desde Grilla.</span></div>}</section>:
  <section className="opCard"><div className="opCardHead"><div><h2>{pique.correlativo?`PIQUE #${pique.correlativo}`:"PIQUE PREPARADO"}</h2><p>Ronda {String(pique.ronda).replaceAll("_"," ")} · Estado {String(pique.estado).replaceAll("_"," ")}</p></div><span className={`opBadge ${pique.estado==="EN_REVISION"?"danger":"warn"}`}>{pique.estado}</span></div><div className="preparedLanes">{laneRows.map((l:any)=><div key={l.pique_piloto_id}><small>{String(l.pista).replace("_"," ")}</small><b>{labelById.get(l.participacion_id)||"Piloto"}</b><strong className="laneTime">{l.tiempo_final_s!=null?Number(l.tiempo_final_s).toFixed(3):"---.---"}</strong><span>{l.condicion?String(l.condicion).replaceAll("_"," "):"SIN RESULTADO"}</span></div>)}</div>{pique.estado==="PREPARADO"?<><div className={`readyValidation ${readyIssues.length?"blocked":"ok"}`}><div><b>VALIDACIÓN PREVIA A PIQUE LISTO</b><span>{readyIssues.length?"Hay conflictos que deben corregirse antes de habilitar la largada.":"Categoría, ronda, pilotos, duplicidad y bracket validados."}</span></div><strong>{readyIssues.length?"BLOQUEADO":"HABILITADO"}</strong>{readyIssues.length?<ul>{readyIssues.map((x,i)=><li key={i}>{x}</li>)}</ul>:null}</div><div className="quickPreparedPilots">{laneRows.map((l:any)=>{const pr:any=rowById.get(String(l.participacion_id));const prev:any=lastByParticipation.get(String(l.participacion_id));const v:any=pr?.vehicle;return <article key={`quick-${l.pique_piloto_id}`}><div><small>FICHA RÁPIDA · {String(l.pista).replace("_"," ")}</small><b>{pr?.label||"Piloto"}</b><span>{current.def?.codigo||current.def?.nombre} · {String(pr?.estado||"—").replaceAll("_"," ")}</span></div><div><small>VEHÍCULO ASIGNADO</small><b>{v?[v.marca,v.modelo].filter(Boolean).join(" "):"SIN VEHÍCULO"}</b><span>{v?.patente||"—"}</span></div><div><small>ÚLTIMO PIQUE ANTERIOR</small>{prev?<><b>#{prev.correlativo} · {String(prev.ronda).replaceAll("_"," ")}</b><span>{String(prev.pista).replace("_"," ")} · {prev.tiempo_final_s!=null?Number(prev.tiempo_final_s).toFixed(3):"SIN TIEMPO"} · {String(prev.condicion||"—").replaceAll("_"," ")}</span></>:<><b>SIN REGISTRO</b><span>No tiene un pique confirmado anterior en esta categoría.</span></>}</div></article>})}</div></>:null}<div className="cronoActions">{pique.estado==="PREPARADO"?<><form action={markPiqueReady}><input type="hidden" name="pique_id" value={pique.pique_id}/><button className="opPrimary" disabled={readyIssues.length>0}>PIQUE LISTO</button></form><form action={cancelPrestartPique}><input type="hidden" name="pique_id" value={pique.pique_id}/><button className="opCancel">CANCELAR PREPARACIÓN</button></form></>:null}{pique.estado==="LISTO"?<><form action={startCronoPique}><input type="hidden" name="pique_id" value={pique.pique_id}/><input type="hidden" name="categoria_fecha_id" value={current.categoria_fecha_id}/><button className="opConfirm">INICIAR LARGADA</button></form><form action={cancelPrestartPique}><input type="hidden" name="pique_id" value={pique.pique_id}/><button className="opCancel">CANCELAR PIQUE LISTO</button></form><div className="prestartRule"><b>AÚN SIN CORRELATIVO</b><span>Cancelar ahora no genera pique perdido ni efecto deportivo.</span></div></>:null}{pique.estado==="EN_CURSO"?<div className="notice compact"><b>LA LARGADA YA INICIÓ</b><span>Este pique ya no puede cancelarse. Cualquier anomalía debe resolverse mediante resultado, revisión o repetición.</span></div>:null}{pique.estado==="EN_REVISION"?<div className="notice compact"><b>ENVIADO AL JUEZ</b><span>{pique.motivo_revision||"Revisión deportiva pendiente"}</span></div>:null}</div>
  {pique.estado==="EN_CURSO"?<form action={saveCronoResult} className="resultForm"><input type="hidden" name="pique_id" value={pique.pique_id}/><div className="resultLanes">{laneRows.map((l:any)=><fieldset key={l.pique_piloto_id}><legend>{String(l.pista).replace("_"," ")} · {labelById.get(l.participacion_id)||"Piloto"}</legend><div className="resultGrid"><label className="opField">Tiempo final<input name={`tiempo_${l.pique_piloto_id}`} inputMode="decimal" defaultValue={l.tiempo_final_s??""} placeholder="9.512"/></label><label className="opField">Reacción<input name={`reaccion_${l.pique_piloto_id}`} inputMode="decimal" defaultValue={l.reaccion_s??""} placeholder="0.245"/></label><label className="opField">60 ft<input name={`t60_${l.pique_piloto_id}`} inputMode="decimal" defaultValue={l.tiempo_60ft_s??""}/></label><label className="opField">100 m<input name={`t100_${l.pique_piloto_id}`} inputMode="decimal" defaultValue={l.tiempo_100m_s??""}/></label><label className="opField">Velocidad km/h<input name={`vel_${l.pique_piloto_id}`} inputMode="decimal" defaultValue={l.velocidad_final_kmh??""}/></label><label className="opField">Condición<select name={`condicion_${l.pique_piloto_id}`} defaultValue={l.condicion||""} required><option value="">Seleccionar</option><option value="VALIDO">VÁLIDO</option><option value="CAIDO">CAÍDO</option><option value="MADRUGAZO">MADRUGAZO</option><option value="NO_LARGA">NO LARGA</option><option value="LINEA_CENTRAL">LÍNEA CENTRAL</option><option value="SIN_TIEMPO">SIN TIEMPO</option></select></label></div></fieldset>)}</div><div className="resultDecision"><label className="opField">Pasó primero por meta<select name="first_meta" defaultValue={laneRows.find((x:any)=>x.paso_primero_meta)?.participacion_id||"NINGUNO"}><option value="NINGUNO">No corresponde / sin dato</option>{laneRows.map((l:any)=><option key={l.participacion_id} value={l.participacion_id}>{labelById.get(l.participacion_id)}</option>)}</select></label><label className="opField">Resultado deportivo<select name="outcome" defaultValue={pique.sin_ganador?"SIN_GANADOR":pique.ganador_participacion_id||""} required><option value="">Seleccionar</option>{laneRows.map((l:any)=><option key={l.participacion_id} value={l.participacion_id}>GANA · {labelById.get(l.participacion_id)}</option>)}<option value="SIN_GANADOR">SIN GANADOR</option></select></label><button className="opPrimary" type="submit">GUARDAR / VALIDAR RESULTADO</button></div></form>:null}
  {pique.estado==="EN_CURSO"&&laneRows.every((l:any)=>!!l.condicion)?<div className="confirmZone"><form action={confirmCronoPique}><input type="hidden" name="pique_id" value={pique.pique_id}/><button className="opConfirm">CONFIRMAR PIQUE</button></form><form action={sendPiqueToJudge} className="reviewForm"><input type="hidden" name="pique_id" value={pique.pique_id}/><input name="motivo_revision" required placeholder="Motivo de revisión / anomalía"/><button className="opSecondary">ENVIAR A JUEZ</button></form></div>:null}</section>}
  <section className="opCard"><div className="opCardHead"><div><h2>ÚLTIMOS PIQUES CONFIRMADOS</h2><p>Historial de la categoría activa.</p></div><span className="opBadge ok">{Math.min(hist?.length||0,8)} REGISTROS</span></div>{hist?.length?<div className="historyRows">{hist.slice(0,8).map((h:any)=><div key={h.pique_id}><b>#{h.correlativo}</b><span>{String(h.ronda).replaceAll("_"," ")}</span><small>{h.sin_ganador?"SIN GANADOR":labelById.get(h.ganador_participacion_id)||"GANADOR REGISTRADO"}</small></div>)}</div>:<div className="notice"><span>Aún no hay piques confirmados en esta categoría.</span></div>}</section><div className="roleRule">CRONOMETRAJE · Tiempo, condición, orden físico y ganador se guardan por separado. Solo CONFIRMAR PIQUE aplica la consecuencia deportiva.</div></div>
}
async function JuezPanel({s,active}:{s:any,active:any}){
  if(!active)return <div className="operatorPanel"><div className="notice"><b>No existe un evento activo disponible.</b></div></div>;
  const {data:cfs}=await s.from("categoria_fecha").select("categoria_fecha_id,categoria_id,estado,participantes_oficiales,habilita_puntos,puntuacion_confirmada").eq("fecha_id",active.fecha_id);
  const cfIds=(cfs||[]).map((x:any)=>x.categoria_fecha_id);
  const catIds=(cfs||[]).map((x:any)=>x.categoria_id);
  const {data:defs}=catIds.length?await s.from("categorias").select("categoria_id,codigo,nombre,tiempo_limite_s").in("categoria_id",catIds):{data:[]};
  const defMap=new Map((defs||[]).map((x:any)=>[x.categoria_id,x]));
  const cfMap=new Map((cfs||[]).map((x:any)=>[x.categoria_fecha_id,x]));
  const {data:reviews}=cfIds.length?await s.from("piques").select("pique_id,categoria_fecha_id,correlativo,ronda,estado,motivo_revision,ganador_participacion_id,sin_ganador,created_at").in("categoria_fecha_id",cfIds).eq("estado","EN_REVISION").eq("decision_juez_pendiente",true).order("created_at",{ascending:true}):{data:[]};
  const pique=reviews?.[0];
  const {data:audit}=await s.from("auditoria_eventos").select("auditoria_id,accion,motivo,created_at,entidad_id").eq("fecha_id",active.fecha_id).order("created_at",{ascending:false}).limit(12);
  const scoring=<ScoringPanel s={s} cfs={cfs||[]} defMap={defMap}/>;
  const championship=<ChampionshipPanel s={s} temporadaId={active.temporada_id}/>;
  const attendance=<AttendancePanel s={s} active={active}/>;
  const suspension=<SuspensionPanel active={active}/>;
  const continuationVehicles=String(active.estado)==="CONTINUACION"?<ContinuationVehiclePanel s={s} active={active} cfs={cfs||[]}/>:null;
  const closure=<Date