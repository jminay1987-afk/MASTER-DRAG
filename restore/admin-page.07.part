on_confirmada).length;
  const canClose=String(active.estado)!=="SUSPENDIDA"&&String(active.estado)!=="CERRADA_DEFINITIVAMENTE"&&!incomplete.length&&!unresolved&&!scoringPending;
  const {data:lastSummary}=await s.from("fecha_resumenes").select("version,generado_at,contenido_json").eq("fecha_id",active.fecha_id).order("version",{ascending:false}).limit(1);
  const summary:any=lastSummary?.[0];
  return <section className="opCard closureCard"><div className="opCardHead"><div><h2>CIERRE DE FECHA</h2><p>Control final deportivo antes de bloquear definitivamente la fecha.</p></div><span className={`opBadge ${String(active.estado)==="CERRADA_DEFINITIVAMENTE"?"ok":canClose?"ok":"warn"}`}>{String(active.estado).replaceAll("_"," ")}</span></div>
    <div className="closureStats"><div><small>CATEGORÍAS</small><b>{cfs.length-incomplete.length} / {cfs.length} resueltas</b></div><div><small>PENDIENTES DEPORTIVOS</small><b>{unresolved}</b></div><div><small>PUNTUACIONES PENDIENTES</small><b>{scoringPending}</b></div></div>
    <div className="closureCats">{cfs.map((cf:any)=>{const d:any=defMap.get(cf.categoria_id);const pending=!["OFICIAL","NO_CONSIDERADA"].includes(String(cf.estado));return <article key={cf.categoria_fecha_id}><div><b>{d?.codigo||d?.nombre||"CATEGORÍA"}</b><span>{cf.participantes_oficiales||0} participantes · {cf.habilita_puntos?"Puntuable":"Sin puntos"}</span></div><strong>{String(cf.estado).replaceAll("_"," ")}</strong>{String(active.estado)==="CONTINUACION"&&pending?<form action={markCategoryNotConsidered} className="noConsiderForm"><input type="hidden" name="categoria_fecha_id" value={cf.categoria_fecha_id}/><input name="confirmacion" required placeholder="Escribe NO CONSIDERADA"/><button className="opSecondary">DECLARAR NO CONSIDERADA</button></form>:null}</article>})}</div>
    {String(active.estado)==="CERRADA_DEFINITIVAMENTE"?<div className="notice"><b>FECHA CERRADA DEFINITIVAMENTE</b><span>{summary?`Resumen oficial v${summary.version} generado ${new Date(summary.generado_at).toLocaleString("es-CL",{timeZone:"America/Santiago"})}.`:"La fecha está cerrada; los datos deportivos están bloqueados."}</span></div>:canClose?<form action={closeDateDefinitely} className="closeDateForm"><input type="hidden" name="fecha_id" value={active.fecha_id}/><label><input type="checkbox" name="confirmar_1" value="SI" required/> Confirmo que revisé categorías, resultados, puntuaciones y decisiones pendientes.</label><label className="opField">Segunda confirmación<input name="confirmar_2" required placeholder="Escribe CERRAR FECHA"/></label><button className="opConfirm">CERRAR FECHA DEFINITIVAMENTE</button><small>Después de este cierre no se permiten nuevos piques, anulaciones, repeticiones ni cambios deportivos.</small></form>:<div className="notice"><b>CIERRE BLOQUEADO</b><span>{String(active.estado)==="SUSPENDIDA"?"Existe una continuación pendiente.":incomplete.length?`${incomplete.length} categoría(s) todavía no están OFICIAL o NO CONSIDERADA.`:unresolved?`${unresolved} pique(s), revisión(es) o decisión(es) siguen pendientes.`:`${scoringPending} puntuación(es) todavía no han sido confirmadas.`}</span></div>}
  </section>
}
function AuditRows({rows}:{rows:any[]}){return <section className="opCard"><div className="opCardHead"><div><h2>BITÁCORA DE EVENTOS</h2><p>Historial del evento visible para Juez y Administrador.</p></div><span className="opBadge ok">TRAZABILIDAD ACTIVA</span></div><div className="auditRows">{rows.length?rows.map((a:any)=><div key={a.auditoria_id}><b>{new Date(a.created_at).toLocaleTimeString("es-CL",{hour:"2-digit",minute:"2-digit",second:"2-digit",timeZone:"America/Santiago"})}</b><span>{String(a.accion).replaceAll("_"," ")}{a.motivo?` · ${a.motivo}`:""}</span><small>{String(a.accion).startsWith("JUEZ")?"JUEZ":"SISTEMA"}</small></div>):<div><span>Sin eventos registrados todavía.</span></div>}</div></section>}

