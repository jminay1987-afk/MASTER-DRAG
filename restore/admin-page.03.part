if(query){
    const safe=query.replaceAll(","," "); const {data:base}=await s.from("pilotos").select("piloto_id,rut,nombres,apellidos,estado").or(`rut.ilike.%${safe}%,nombres.ilike.%${safe}%,apellidos.ilike.%${safe}%`).limit(15); const m=new Map((base||[]).map((x:any)=>[x.piloto_id,x]));
    const n=Number(query.replace(/\D/g,"")); if(Number.isFinite(n)&&n>0){const {data:nr}=await s.from("piloto_temporada").select("piloto_id").eq("temporada_id",active.temporada_id).eq("numero_competencia",n).limit(10);const ids=(nr||[]).map((x:any)=>x.piloto_id).filter((id:string)=>!m.has(id));if(ids.length){const {data:extra}=await s.from("pilotos").select("piloto_id,rut,nombres,apellidos,estado").in("piloto_id",ids);for(const x of extra||[])m.set(x.piloto_id,x)}} pilots=[...m.values()];
  }
  const ids=pilots.map((x:any)=>x.piloto_id); const {data:pts}=ids.length?await s.from("piloto_temporada").select("piloto_temporada_id,piloto_id,numero_competencia").eq("temporada_id",active.temporada_id).in("piloto_id",ids):{data:[]}; const ptm=new Map((pts||[]).map((x:any)=>[x.piloto_id,x])); const ptids=(pts||[]).map((x:any)=>x.piloto_temporada_id);
  const {data:parts}=ptids.length?await s.from("participaciones_categoria").select("participacion_id,piloto_temporada_id,categoria_fecha_id,estado,primer_pique_oficial_at,vehiculo_id").in("piloto_temporada_id",ptids):{data:[]}; const cfids=[...new Set((parts||[]).map((x:any)=>x.categoria_fecha_id))]; const {data:cfs}=cfids.length?await s.from("categoria_fecha").select("categoria_fecha_id,categoria_id,fecha_id").eq("fecha_id",active.fecha_id).in("categoria_fecha_id",cfids):{data:[]}; const cids=[...new Set((cfs||[]).map((x:any)=>x.categoria_id))]; const {data:defs}=cids.length?await s.from("categorias").select("categoria_id,codigo,nombre").in("categoria_id",cids):{data:[]}; const dm=new Map((defs||[]).map((x:any)=>[x.categoria_id,x])); const cfm=new Map((cfs||[]).map((x:any)=>[x.categoria_fecha_id,x]));
  const mask=(rut:string)=>{const x=String(rut||"");return x.length>4?`${x.slice(0,2)}.***.***-${x.slice(-1)}`:"***"};
  return <section className="opCard quickPilotSearch"><div className="opCardHead"><div><h2>BUSCADOR RÁPIDO DE PILOTO</h2><p>Solo lectura · número, nombre o RUT. No modifica inscripciones ni decisiones deportivas.</p></div><span className="opBadge ok">{role}</span></div><form method="get" className="pilotSearchForm">{cat?<input type="hidden" name="cat" value={cat}/>:null}<label className="opField">Buscar<input name="q" defaultValue={query} placeholder="Número, nombre o RUT" autoComplete="off"/></label><button className="opPrimary">BUSCAR</button></form>{query?<div className="quickSearchRows">{pilots.length?pilots.map((p:any)=>{const pt:any=ptm.get(p.piloto_id);const mine=(parts||[]).filter((x:any)=>x.piloto_temporada_id===pt?.piloto_temporada_id).filter((x:any)=>cfm.has(x.categoria_fecha_id));return <article key={p.piloto_id}><div><b>#{pt?.numero_competencia??"—"} · {p.nombres} {p.apellidos}</b><small>RUT {mask(p.rut)}</small></div><div>{mine.length?mine.map((x:any)=>{const cf:any=cfm.get(x.categoria_fecha_id);const d:any=cf?dm.get(cf.categoria_id):null;return <span key={x.participacion_id}>{d?.codigo||d?.nombre||"Categoría"}: {x.primer_pique_oficial_at?"YA CORRIÓ":String(x.estado).replaceAll("_"," ")}</span>}):<span>NO INSCRITO EN ESTA FECHA</span>}</div></article>}):<div className="notice compact"><b>Sin coincidencias</b><span>No hay pilotos registrados para “{query}”.</span></div>}</div>:null}</section>
}

function Lane({lane,name,time,condition}:{lane:string,name:string,time:string,condition:string}){return <article className="laneCard"><small>{lane}</small><select defaultValue={name}><option>{name}</option><option>#24 — Eduardo Zamora</option></select><div className="metrics"><label>TIEMPO FINAL<input className="bigTime" defaultValue={time}/></label><label>REACCIÓN<input defaultValue="0.284"/></label><label>60 FT<input placeholder="—"/></label><label>VELOCIDAD KM/H<input placeholder="—"/></label></div><label className="opField">CONDICIÓN / INCIDENTE<select defaultValue={condition}><option>VÁLIDO</option><option>CAÍDO</option><option>MADRUGAZO</option><option>NO LARGA</option><option>LÍNEA CENTRAL</option><option>SIN TIEMPO</option></select></label><button className="opSecondary">PASÓ PRIMERO META</button></article>}
async function CronoPanel({s,active,selectedCat,quickQ}:{s:any,active:any,selectedCat?:string,quickQ?:string}){
  if(!active)return <div className="operatorPanel"><div className="notice"><b>No existe una fecha disponible.</b></div></div>;
  if(String(active.estado)==="SUSPENDIDA")return <div className="operatorPanel"><div className="notice"><b>FECHA SUSPENDIDA</b><span>Cronometraje está bloqueado. Los piques y el bracket permanecen congelados hasta la continuación.</span></div></div>;
  const {data:cats}=await s.from("categoria_fecha").select("categoria_fecha_id,categoria_id,estado,orden_operativo").eq("fecha_id",active.fecha_id).order("orden_operativo");
  const catIds=(cats||[]).map((x:any)=>x.categoria_id);const {data:defs}=catIds.length?await s.from("categorias").select("categoria_id,codigo,nombre,tiempo_limite_s").in("categoria_id",catIds):{data:[]};const dm=new Map((defs||[]).map((d:any)=>[d.categoria_id,d]));const full=(cats||[]).map((c:any)=>({...c,def:dm.get(c.categoria_id)}));const current=full.find((c:any)=>c.categoria_fecha_id===selectedCat)||full[0];if(!current)return <div className="notice">Sin categorías</div>;
  const {data:pcs}=await s.from("participaciones_categoria").select("participacion_id,piloto_temporada_id,vehiculo_id,estado,primer_pique_oficial_at").eq("categoria_fecha_id",current.categoria_fecha_id).eq("retiro_definitivo",false);
  const ptIds=(pcs||[]).map((x:any)=>x.piloto_temporada_id);const {data:pts}=ptIds.length?await s.from("piloto_temporada").select("piloto_temporada_id,piloto_id,numero_competencia").in("piloto_temporada_id",ptIds):{data:[]};const piIds=(pts||[]).map((x:any)=>x.piloto_id);const {data:pis}=piIds.length?await s.from("pilotos").select("piloto_id,nombres,apellidos").in("piloto_id",piIds):{data:[]};const vehicleIds=[...new Set((pcs||[]).map((x:any)=>x.vehiculo_id).filter(Boolean))];const {data:vehicles}=vehicleIds.length?await s.from("vehiculos").select("vehiculo_id,marca,modelo,patente").in("vehiculo_id",vehicleIds):{data:[]};const vm=new Map((vehicles||[]).map((x:any)=>[x.vehiculo_id,x]));const pm=new Map((pis||[]).map((x:any)=>[x.piloto_id,x]));const tm=new Map((pts||[]).map((x:any)=>[x.piloto_temporada_id,x]));const rows=(pcs||[]).map((pc:any)=>{const pt:any=tm.get(pc.piloto_temporada_id);const pi:any=pt?pm.get(pt.piloto_id):null;const vehicle:any=pc.vehiculo_id?vm.get(pc.vehiculo_id):null;return {...pc,pt,pi,vehicle,label:`#${pt?.numero_competencia??"—"} — ${pi?`${pi.nombres} ${pi.apellidos}`:"Piloto"}`}});
  const {data:open}=await s.from("piques").select("pique_id,correlativo,ronda,estado,created_at,ganador_participacion_id,sin_ganador,motivo_revision").eq("categoria_fecha_id",current.categoria_fecha_id).in("estado",["PREPARADO","LISTO","EN_CURSO","EN_REVISION"]).order("created_at",{ascending:false}).limit(1);const pique=open?.[0];let laneRows:any[]=[];if(pique){const {data:ls}=await s.from("pique_pilotos").select("pique_piloto_id,participacion_id,pista,vehiculo_id,tiempo_final_s,reaccion_s,tiempo_60ft_s,tiempo_100m_s,velocidad_final_kmh,condicion,paso_primero_meta,gana_pique").eq("pique_id",pique.pique_id).order("pista");laneRows=ls||[]}
  const labelById=new Map(rows.map((r:any)=>[r.participacion_id,r.label]));
  const {data:bracketNodes}=await s.from("bracket_nodos").select("bracket_nodo_id,ronda,orden_nodo,participacion_a_id,participacion_b_id,es_bye,pique_id,ganador_participacion_id").eq("categoria_fecha_id",current.categoria_fecha_id).order("orden_nodo");
  const pendingBracket=(bracketNodes||[]).filter((n:any)=>!n.es_bye&&!n.pique_id&&!n.ganador_participacion_id);
  const {data:hist}=await s.from("piques").select("pique_id,correlativo,ronda,confirmado_at,ganador_participacion_id,sin_ganador").eq("categoria_fecha_id",current.categoria_fecha_id).eq("estado","CONFIRMADO").order("confirmado_at",{ascending:false}).limit(100);
  const histIds=(hist||[]).map((h:any)=>h.pique_id);const {data:histLanes}=histIds.length?await s.from("pique_pilotos").select("pique_id,participacion_id,pista,tiempo_final_s,condicion").in("pique_id",histIds):{data:[]};const histLaneByPique=new Map<string,any[]>();for(const l of histLanes||[]){const a=histLaneByPique.get(String(l.pique_id))||[];a.push(l);histLaneByPique.set(String(l.pique_id),a)}const lastByParticipation=new Map<string,any>();for(const h of hist||[])for(const l of histLaneByPique.get(String(h.pique_id))||[])if(!lastByParticipation.has(String(l.participacion_id)))lastByParticipation.set(String(l.participacion_id),{...l,correlativo:h.correlativo,ronda:h.ronda});
  const rowById=new Map(rows.map((r:any)=>[String(r.participacion_id),r]));
  const readyIssues:string[]=[];
  if(pique?.estado==="PREPARADO"){
    if(!["EN_COMPETENCIA","CONTINUACION"].includes(String(active.estado)))readyIssues.push("La jornada de competencia todavía no está activa.");
    const r=String(pique.ronda),cs=String(current.estado);
    if((["PENDIENTE","PRIMERA_RONDA"].includes(cs)&&r!=="PRIMERA")||(cs==="PERDEDORES"&&r!=="PERDEDORES")||(cs==="MATA_MATA"&&!["OTRA","CUARTOS","SEMIFINAL","FINAL"].includes(r)))readyIssues.push("La ronda preparada no corresponde a la etapa activa de la categoría.");
    if(!laneRows.length||laneRows.length>2)readyIssues.push("El pique debe tener uno o dos pilotos correctamente preparados.");
    const ids=laneRows.map((l:any)=>String(l.participacion_id));if(new Set(ids).size!==ids.length)readyIssues.push("Hay un piloto duplicado entre las pistas.");
    for(const id of ids){const pr:any=rowById.get(id);if(!pr){readyIssues.push("Hay un piloto que ya no pertenece a la categoría.");continue}const st=String(pr.estado);if(pr.retiro_definitivo)readyIssues.push(`${pr.label} está retirado.`);if(r==="PRIMERA"&&!["INSCRITO","PRIMERA_RONDA"].includes(st))readyIssues.push(`${pr.label} ya no está habilitado para Primera Ronda.`);if(r==="PERDEDORES"&&st!=="PERDEDORES")readyIssues.push(`${pr.label} no está habilitado para Perdedores.`);if(["OTRA","CUARTOS","SEMIFINAL","FINAL"].includes(r)&&st!=="MATA_MATA")readyIssues.push(`${pr.label} no está habilitado para este cruce.`)}
    if(["PRIMERA","PERDEDORES"].includes(r)&&ids.length){const {data:done}=await s.from("piques").select("pique_id").eq("categoria_fecha_id",current.categoria_fecha_id).eq("ronda",r).eq("estado","CONFIRMADO");const doneIds=(done||[]).map((x:any)=>x.pique_id);if(doneIds.length){const {data:used}=await s.from("pique_pilotos").select("participacion_id").in("pique_id",doneIds).in("participacion_id",ids);if(used?.length)readyIssues.push(r==="PRIMERA"?"Uno de los pilotos ya realizó su Primera Ronda.":"Uno de los pilotos ya utilizó su única pasada de Perdedores.")}}
    if(["OTRA","CUARTOS","SEMIFINAL","FINAL"].includes(r)){const pair=ids.slice().sort().join("|");const match=(bracketNodes||[]).some((n:any)=>!n.es_bye&&String(n.pique_id||"")===String(pique.pique_id)&&!n.ganador_participacion_id&&[String(n.participacion_a_id||""),String(n.participacion_b_id||"")].filter(Boolean).sort().join("|")===pair);if(!match)readyIssues.push("El cruce ya no coincide con el bracket pendiente.")}
  }
  return <div className="operatorPanel"><section className="opSummary"><div><small>EVENTO</small><b>{active.nombre}</b></div><div><small>CATEGORÍA</small><b>{current.def?.codigo||current.def?.nombre}</b></div><div><small>PIQUE</small><b>{pique?String(pique.estado).replaceAll("_"," "):"SIN PIQUE ABIERTO"}</b></div></section><section className="opCard"><div className="opCardHead"><div><h2>SELECCIONAR CATEGORÍA</h2><p>Cronometraje recibe los pilotos incorporados desde Grilla.</p></div><span className="opBadge ok">{rows.length} PILOTOS</span></div><div className="catTabs">{full.map((c:any)=><a classNam